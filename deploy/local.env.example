# Copy to .env in the MCP repository root (do not overwrite an existing .env).
# Relative paths are resolved from FacadeFixer_mcp, the backend working directory.
FACADE_WORKSPACE=./workspace/web/mcp
FACADE_WEB_WORKSPACE=./workspace/web
FACADE_ALLOWED_INPUT_ROOTS=./workspace;./examples
FACADE_MASK_REPO=./vendor/FacadeFixer_mask_api
FACADE_REPORT_REPO=./vendor/FacadeFixer_report
FACADE_SOURCE_REPO=../FacadeFixer-main
FACADE_SOURCE_PYTHON=../FacadeFixer-main/.venv/Scripts/python.exe
FACADE_SOURCE_DEVICE=cpu
FACADE_SOURCE_TIMEOUT_SECONDS=900
