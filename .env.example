# Server-side configuration. Do not commit keys or provider configs containing keys.
FACADE_WORKSPACE=./workspace
# Semicolon-separated absolute input roots on Windows.
FACADE_ALLOWED_INPUT_ROOTS=.
FACADE_MASK_REPO=./vendor/FacadeFixer_mask_api
FACADE_REPORT_REPO=./vendor/FacadeFixer_report
# Optional existing detector API; local justification is explicitly disabled.
FACADE_DETECTOR_URL=http://127.0.0.1:8000
FACADE_DETECTOR_MODEL=yolo12m
# Optional local YOLO mode; runtime already needs torch+ultralytics.
FACADE_DETECTOR_PYTHON=
FACADE_DETECTOR_WEIGHTS=
# Local FacadeFixer model service (separate model runtime; no paid requests).
# These example paths are relative to this project; use absolute paths in deployed clients.
FACADE_SOURCE_REPO=../项目代码/FacadeFixer-main
FACADE_SOURCE_PYTHON=../项目代码/FacadeFixer-main/.venv/Scripts/python.exe
FACADE_SOURCE_DEVICE=cpu
FACADE_SOURCE_TIMEOUT_SECONDS=600
# Optional paid image mask provider, upstream-compatible server-owned models.json.
FACADE_MASK_MODELS_CONFIG=
# Optional tool-capable OpenAI-compatible language model. Choose your own model.
FACADE_LLM_MODEL=
FACADE_LLM_BASE_URL=
FACADE_LLM_API_KEY=
